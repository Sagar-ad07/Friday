# ─── Friday Base - Minimal-Cost Configuration ──────────────────────────────────
# Copy this file to ".env". For the default cheap local mode you only NEED ONE
# free key: GROQ_API_KEY. Everything else is optional.
# Get a free Groq key (no card): https://console.groq.com/keys

# ── Provider API keys (ONLY GROQ required for text chat) ──
GROQ_API_KEY=your_groq_key_here       # REQUIRED (free). Chat + reasoning + Whisper STT.
SARVAM_API_KEY=                       # OPTIONAL + PAID. Only if you enable TTS_PAID_ENABLED / Sarvam STT.
GEMINI_API_KEY=                       # OPTIONAL (free). Used only by the eye/vision chain.
DEEPSEEK_API_KEY=                     # OPTIONAL (cheap). Strong coding/reasoning.
OPENROUTER_API_KEY=                   # OPTIONAL. One key -> many free models.
OPENAI_API_KEY=                       # OPTIONAL (paid). Used only by the eye/vision chain.

# ── Model per provider (override if you want) ──
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3

# ── Cost-control / "thinks-like-you" toggles ──
SINGLE_CALL_MODE=true        # Default text path = instant triage + 1 reasoning call.
TTS_PAID_ENABLED=false       # FALSE = free edge-tts; Sarvam (paid) only if you flip this true.
ENABLE_USER_MEMORY=true      # Remember the user (name/prefs) locally, 0 extra calls.
ENABLE_ANTICIPATION=true     # Local follow-up hints via /suggest, 0 extra calls.
ENABLE_SELFCHECK=false       # true = +1 verify pass (higher fidelity, ~2 calls/turn).
LOCAL_CACHE_TTL=600          # Local answer cache TTL (s). 0 = disabled. Repeat Q/A = 0 calls.

# ── Per-role provider CHAINS (comma-separated, first that works wins) ──
# COMPANION_CHAIN=groq,gemini,openrouter
# REASONER_CHAIN=groq,deepseek,gemini
# CODER_CHAIN=deepseek,groq,gemini
# RESEARCHER_CHAIN=groq,gemini,openrouter
# JUDGE_CHAIN=gemini,groq,deepseek
# VERIFIER_CHAIN=gemini,groq,deepseek
# ROUTER_CHAIN=groq,gemini,deepseek

# ── Resilience (never-crash tuning) ──
MAX_RETRIES=2
VERIFY_PASSES=0              # 0=off (use ENABLE_SELFCHECK for the cheap self-check instead)
BREAKER_THRESHOLD=4
BREAKER_COOLDOWN=60

# ── Voice (text chat needs NONE of this) ──
STT_PROVIDER=sarvam          # sarvam | groq | local  (only used on /voice)
TTS_ENGINE=edge              # edge (FREE, default) | sarvam (paid, needs TTS_PAID_ENABLED=true)
TTS_VOICE_EN=en-IN-ShaanNeural
TTS_VOICE_EDGE=en-IN-NeerjaNeural

# ── Server ──
DEPLOY_MODE=local            # LOCAL-FIRST. Cloud (Fly/Railway) is opt-in, not required.
HOST=0.0.0.0
PORT=8000
DEV_MODE=true
MEMORY_DIR=data/base

# Security: if set, all API endpoints require  Authorization: Bearer <this>
FRIDAY_TOKEN=
# Master switch for tools that execute code/commands/open apps (default ON for
# local use). Set to false on untrusted/shared deployments.
ENABLE_EXEC_TOOLS=true
# desktop_control (mouse/keyboard) also needs: pip install pyautogui

# ── Long-session tuning ──
TURN_DEADLINE_SECONDS=120    # Raised so long voice/spoken answers aren't cut at 45s.
