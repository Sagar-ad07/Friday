<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kill_background"
    android:padding="24dp">

    <!-- Warning Icon -->
    <ImageView
        android:id="@+id/kill_icon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="48dp"
        android:src="@drawable/ic_kill_warning"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/kill_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/kill_switch_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/kill_red"
        android:fontFamily="@font/google_sans_bold"
        app:layout_constraintTop_toBottomOf="@id/kill_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Message -->
    <TextView
        android:id="@+id/kill_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="@string/kill_switch_message"
        android:textSize="16sp"
        android:textColor="@color/friday_text"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/kill_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Warning Items -->
    <TextView
        android:id="@+id/kill_items"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="@string/kill_switch_items"
        android:textSize="14sp"
        android:textColor="@color/friday_text"
        android:lineSpacingExtra="4dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/kill_message"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Warning -->
    <TextView
        android:id="@+id/kill_warning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="@string/kill_warning"
        android:textSize="13sp"
        android:textColor="@color/kill_warning_text"
        android:background="@color/kill_warning_bg"
        android:padding="12dp"
        android:gravity="center"
        android:fontFamily="@font/google_sans_medium"
        app:layout_constraintTop_toBottomOf="@id/kill_items"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Input Label -->
    <TextView
        android:id="@+id/kill_input_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="@string/kill_type_here"
        android:textSize="13sp"
        android:textColor="@color/friday_mint"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/kill_warning"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Input Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/kill_input_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:hint="@string/kill_type_here"
        android:hintEnabled="false"
        android:theme="@style/Theme.Friday.TextInputLayout"
        app:layout_constraintTop_toBottomOf="@id/kill_input_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/kill_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:textSize="18sp"
            android:textColor="@color/friday_text"
            android:backgroundTint="@color/friday_indigo"
            android:maxLength="4"
            android:imeOptions="actionDone" />

        </com.google.android.material.textfield.TextInputLayout>

</androidx.constraintlayout.widget.ConstraintLayout>